generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String
  passwordHash    String
  prodi           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  refreshTokens   UserRefreshToken[]
  etholCredentials EtholCredential[]
  subTasks        SubTask[]
  tasks           Task[]
  taskStatusOverrides TaskStatusOverride[]

  @@map("users")
}

model UserRefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("user_refresh_tokens")
}

model EtholCredential {
  id                      String   @id @default(uuid())
  etholNrp                String   @unique
  etholEmail              String?
  etholNama               String
  etholNomor              Int
  encryptedRefreshToken   String
  refreshTokenIv          String
  refreshTokenTag         String
  refreshTokenExpiresAt   DateTime
  linkedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  courses                 Course[]

  @@index([userId])
  @@index([etholEmail])
  @@map("ethol_credentials")
}

model Course {
  id              String  @id @default(uuid())
  etholNomor      Int     @unique
  nama            String
  dosen           String?
  kodeKelas       String?
  tahun           Int
  semester        Int

  credentialId    String
  credential      EtholCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  schedules       Schedule[]
  assignments     Assignment[]

  @@map("courses")
}

model Schedule {
  id          String  @id @default(uuid())
  hari        String
  jamMulai    String
  jamSelesai  String
  ruang       String?

  courseId     String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Assignment {
  id              String    @id @default(uuid())
  etholTugasId    Int?
  judul           String
  deskripsi       String?
  deadline        DateTime?
  submissionTime  DateTime?

  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("assignments")
}

model SubTask {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
  @@map("sub_tasks")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  course      String
  deadline    DateTime?
  deadlineRaw String?
  description String?
  status      String    @default("todo")
  priority    String    @default("mendatang")
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("tasks")
}

model TaskStatusOverride {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@map("task_status_overrides")
}
