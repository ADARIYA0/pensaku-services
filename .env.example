# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration
# Available levels: fatal, error, warn, info, debug, trace (Default: info, or debug in development)
LOG_LEVEL=info

# Rate Limiting Configuration
# Window time in minutes (default: 15)
RATE_LIMIT_WINDOW_MINUTES=15
# Maximum general API requests per IP per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100
# Maximum sensitive auth/sync requests per IP per window (default: 10)
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Database (PostgreSQL via Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase SDK Credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
