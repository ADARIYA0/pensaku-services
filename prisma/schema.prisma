generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EtholCredential {
  id                      String   @id @default(uuid())
  etholNrp                String   @unique
  etholEmail              String?
  etholNama               String
  etholNomor              Int
  encryptedRefreshToken   String
  refreshTokenIv          String
  refreshTokenTag         String
  refreshTokenExpiresAt   DateTime
  linkedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt

  courses                 Course[]

  @@index([etholEmail])
  @@map("ethol_credentials")
}

model Course {
  id              String  @id @default(uuid())
  etholNomor      Int     @unique
  nama            String
  dosen           String?
  kodeKelas       String?
  tahun           Int
  semester        Int

  credentialId    String
  credential      EtholCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  schedules       Schedule[]
  assignments     Assignment[]

  @@map("courses")
}

model Schedule {
  id          String  @id @default(uuid())
  hari        String
  jamMulai    String
  jamSelesai  String
  ruang       String?

  courseId     String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Assignment {
  id              String    @id @default(uuid())
  etholTugasId    Int?
  judul           String
  deskripsi       String?
  deadline        DateTime?
  submissionTime  DateTime?

  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("assignments")
}
